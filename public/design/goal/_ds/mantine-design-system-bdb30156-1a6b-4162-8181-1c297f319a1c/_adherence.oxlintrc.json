{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/data-display/**",
              "components/feedback/**",
              "components/inputs/**",
              "components/navigation/**",
              "ui_kits/dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|color|size|radius|disabled|key|ref|className|style|children)$/]",
        "message": "<ActionIcon> doesn't accept that prop. Declared props: children, variant, color, size, radius, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionIcon'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|light|outline|subtle|transparent|default)$/]",
        "message": "<ActionIcon> variant must be one of 'filled' | 'light' | 'outline' | 'subtle' | 'transparent' | 'default'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionIcon'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:xs|sm|md|lg|xl)$/]",
        "message": "<ActionIcon> radius must be one of 'xs' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|color|variant|icon|withCloseButton|onClose|radius|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: children, title, color, variant, icon, withCloseButton, onClose, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|filled|outline|default)$/]",
        "message": "<Alert> variant must be one of 'light' | 'filled' | 'outline' | 'default'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:xs|sm|md|lg|xl)$/]",
        "message": "<Alert> radius must be one of 'xs' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|children|size|radius|color|variant|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, alt, children, size, radius, color, variant."
